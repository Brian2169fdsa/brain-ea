    {
      "id": 8,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "deal_profile",
        "value": "{\"deal\":{{JSON.stringify(steps[3].data)}},\"timeline\":{{JSON.stringify(steps[4].data)}},\"participants\":{{JSON.stringify(steps[5].data)}},\"facts\":{{JSON.stringify(steps[6])}},\"tasks\":{{JSON.stringify(steps[7])}}}"
      },
