{
  "name": "EA-08 — Knowledge Base Operations",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {
        "ip": "",
        "method": "POST",
        "headers": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "REPLACE_WITH_DB_ID"
      },
      "mapper": {
        "filter": {
          "property": "Title",
          "title": {
            "contains": "{{trigger.query}}"
          }
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "REPLACE_WITH_DB_ID"
      },
      "mapper": {
        "properties": {
          "Title": {
            "title": [
              {
                "text": {
                  "content": "{{trigger.content.title}}"
                }
              }
            ]
          },
          "Category": {
            "select": {
              "name": "{{trigger.content.category}}"
            }
          },
          "Created By": {
            "select": {
              "name": "Claude EA"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{{JSON.stringify($result)}}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}