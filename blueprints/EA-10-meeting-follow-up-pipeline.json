{
  "name": "EA-10 — Meeting Follow-Up Pipeline",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {
        "ip": "",
        "method": "POST",
        "headers": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-81f5-acbd-eba375ff49a6"
      },
      "mapper": {
        "filter": {
          "property": "Title",
          "title": {
            "is_not_empty": true
          }
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{webhooks.EA03_URL}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"interaction_id\":\"{{trigger.meeting_id}}\",\"type\":\"transcript\"}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-810e-ac39-f1d2e92b9167"
      },
      "mapper": {
        "filter": {
          "property": "Source Interaction",
          "relation": {
            "contains": "{{trigger.meeting_id}}"
          }
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{steps[5]}}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{webhooks.EA07_URL}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"action\":\"create\",\"task\":{\"name\":\"{{item.claim}}\",\"priority\":\"P2\"}}"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    },
    {
      "id": 8,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "x-api-key",
            "value": "{{env.ANTHROPIC_API_KEY}}"
          },
          {
            "name": "anthropic-version",
            "value": "2023-06-01"
          }
        ],
        "body": "{\"model\":\"claude-sonnet-4-5-20250929\",\"max_tokens\":2000,\"temperature\":0.3,\"system\":\"Draft a concise, professional meeting recap message. This will be sent to attendees via Teams.\\n\\nGiven the meeting summary and extracted facts, create a recap that includes:\\n\\n1. Brief summary (2-3 sentences)\\n2. Key decisions made (bullet points)\\n3. Action items with owners and due dates\\n4. Next steps\\n\\nTone: warm but business-focused. Keep it under 200 words. Don't include \\\"Sent via Claude EA\\\" — that's added automatically.\\n\",\"messages\":[{\"role\":\"user\",\"content\":\"Draft a meeting recap:\\n\\n{{JSON.stringify(steps[5])}}\"}]}"
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0
        }
      }
    },
    {
      "id": 9,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{trigger.attendees}}"
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0
        }
      }
    },
    {
      "id": 10,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{webhooks.EA09_URL}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"action\":\"send_dm\",\"to\":\"{{item}}\",\"message\":\"{{steps[8].content[0].text}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 3000,
          "y": 0
        }
      }
    },
    {
      "id": 11,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{\"success\":true}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 3300,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}