        "designer": {
          "x": 2400,
          "y": 0
        }
      }
    },
    {
      "id": 9,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "x-api-key",
            "value": "{{env.ANTHROPIC_API_KEY}}"
          },
          {
            "name": "anthropic-version",
            "value": "2023-06-01"
          }
        ],
        "body": "{\"model\":\"claude-sonnet-4-5-20250929\",\"max_tokens\":4000,\"temperature\":0.3,\"system\":\"You are formatting a deal intelligence brief for Brian.\\n\\nGiven Pipedrive deal data combined with relationship facts from the EA intelligence system, create a comprehensive deal assessment.\\n\\nFORMAT:\\n💰 [DEAL NAME] — [Stage] — $[Value]\\nExpected close: [Date] | Pipeline: [Pipeline name]\\nOwner: [Person] | Created: [Date]\\n\\n👥 KEY STAKEHOLDERS\\n- For each participant: role, recent facts, concerns, commitments\\n\\n📊 DEAL TIMELINE\\n- Stage progression with dates\\n- Key milestones and decisions\\n\\n🎯 COMMITMENTS & NEXT STEPS\\n- What Brian committed to for this deal\\n- What the prospect committed to\\n- Upcoming deadlines\\n\\n⚠️ RISKS & BLOCKERS\\n- Concerns raised by anyone involved\\n- Competitor mentions\\n- Stale activity (no recent interaction)\\n- Overdue commitments\\n\\n📈 DEAL HEALTH ASSESSMENT\\n- Engagement level (based on interaction frequency)\\n- Sentiment trend (based on recent facts)\\n- Win probability assessment (based on signals)\\n\\nSource-ground everything. Be direct about risks.\\n\",\"messages\":[{\"role\":\"user\",\"content\":\"Format a deal intelligence brief:\\n\\n{{variables.deal_profile}}\"}]}"
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0
        }
      }
    },
    {
      "id": 10,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{{body.content[0].text}}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 3000,
          "y": 0
        }
      }
    }
