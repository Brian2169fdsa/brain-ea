# ═══════ NOTION ═══════
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_REPLACE_ME

# These get populated by Script 01 after database creation:
NOTION_RELATIONSHIPS_DB=
NOTION_FACTS_DB=
NOTION_INTERACTIONS_DB=
NOTION_TASKS_DB=
NOTION_KB_DB=

# ═══════ ANTHROPIC ═══════
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ═══════ MICROSOFT GRAPH (Azure AD App) ═══════
# Register at: https://portal.azure.com → Azure Active Directory → App registrations
# Required permissions: OnlineMeetings.Read.All, Chat.Read.All, Mail.Read, Chat.ReadWrite, User.Read
AZURE_CLIENT_ID=REPLACE_ME
AZURE_TENANT_ID=REPLACE_ME
AZURE_CLIENT_SECRET=REPLACE_ME

# ═══════ PIPEDRIVE ═══════
# Get from: Pipedrive → Settings → Personal preferences → API
PIPEDRIVE_API_TOKEN=REPLACE_ME
# Your Pipedrive subdomain (the part before .pipedrive.com)
PIPEDRIVE_DOMAIN=REPLACE_ME

# ═══════ MAKE.COM ═══════
# Get from: Make → Profile → API Access → Create Token
MAKE_API_TOKEN=REPLACE_ME
MAKE_TEAM_ID=REPLACE_ME
