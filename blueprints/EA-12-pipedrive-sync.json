{
  "name": "EA-12 — Pipedrive Sync",
  "flow": [
    {
      "id": 1,
      "module": "builtin:BasicScheduler",
      "version": 1,
      "parameters": {
        "scheduling": {
          "type": "interval",
          "interval": 60
        },
        "time": "07:00"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://{{env.PIPEDRIVE_DOMAIN}}.pipedrive.com/api/v1/recents?since_timestamp={{datastore.last_sync}}&items=person,organization,deal,activity,note&api_token={{env.PIPEDRIVE_API_TOKEN}}",
        "method": "GET",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": ""
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{filterArray(steps[2].data; 'item'; 'person')}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8162-a136-f6449ea9ddbc"
      },
      "mapper": {
        "filter": {
          "property": "Pipedrive Person ID",
          "number": {
            "equals": "{{item.data.id}}"
          }
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8162-a136-f6449ea9ddbc"
      },
      "mapper": {
        "properties": {
          "Name": {
            "title": [
              {
                "text": {
                  "content": "{{item.data.name}}"
                }
              }
            ]
          },
          "Type": {
            "select": {
              "name": "Person"
            }
          },
          "Email": {
            "email": "{{item.data.email[0].value}}"
          },
          "Pipedrive Person ID": {
            "number": "{{item.data.id}}"
          },
          "Stage": {
            "select": {
              "name": "Active"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    },
    {
      "id": 8,
      "module": "notion:updateAPage",
      "version": 2,
      "parameters": {},
      "mapper": {
        "page_id": "{{steps[5][0].id}}",
        "properties": {
          "Email": {
            "email": "{{item.data.email[0].value}}"
          },
          "Last Interaction": {
            "date": {
              "start": "{{formatDate(now; 'YYYY-MM-DD')}}"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0
        }
      }
    },
    {
      "id": 9,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{filterArray(steps[2].data; 'item'; 'activity')}}"
      },
      "metadata": {
        "designer": {
          "x": 2700,
          "y": 0
        }
      }
    },
    {
      "id": 10,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-81f5-acbd-eba375ff49a6"
      },
      "mapper": {
        "properties": {
          "Title": {
            "title": [
              {
                "text": {
                  "content": "{{item.data.subject}}"
                }
              }
            ]
          },
          "Type": {
            "select": {
              "name": "Pipedrive Activity"
            }
          },
          "Source": {
            "select": {
              "name": "Pipedrive"
            }
          },
          "Date": {
            "date": {
              "start": "{{item.data.due_date}}"
            }
          },
          "Raw Content": {
            "rich_text": [
              {
                "text": {
                  "content": "{{item.data.note}}"
                }
              }
            ]
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 3000,
          "y": 0
        }
      }
    },
    {
      "id": 11,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{webhooks.EA03_URL}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"interaction_id\":\"{{steps[10].id}}\",\"type\":\"pipedrive_activity\",\"raw_content\":\"{{item.data.note}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 3300,
          "y": 0
        }
      }
    },
    {
      "id": 12,
      "module": "builtin:BasicIterator",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{filterArray(steps[2].data; 'item'; 'deal')}}"
      },
      "metadata": {
        "designer": {
          "x": 3600,
          "y": 0
        }
      }
    },
    {
      "id": 13,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-81f5-acbd-eba375ff49a6"
      },
      "mapper": {
        "properties": {
          "Title": {
            "title": [
              {
                "text": {
                  "content": "Deal update: {{item.data.title}}"
                }
              }
            ]
          },
          "Type": {
            "select": {
              "name": "Pipedrive Deal Update"
            }
          },
          "Source": {
            "select": {
              "name": "Pipedrive"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 3900,
          "y": 0
        }
      }
    },
    {
      "id": 14,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{webhooks.EA03_URL}}",
        "method": "POST",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"interaction_id\":\"{{steps[13].id}}\",\"type\":\"pipedrive_deal\",\"raw_content\":\"{{JSON.stringify(item.data)}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 4200,
          "y": 0
        }
      }
    },
    {
      "id": 15,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "last_sync",
        "value": "{{formatDate(now; 'YYYY-MM-DDTHH:mm:ssZ')}}"
      },
      "metadata": {
        "designer": {
          "x": 4500,
          "y": 0
        }
      }
    },
    {
      "id": 16,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{\"synced\":{\"items\":{{length(steps[2].data)}}}}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 4800,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}