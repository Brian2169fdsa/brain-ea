{
  "name": "EA-09 — Teams Messenger",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {
        "ip": "",
        "method": "POST",
        "headers": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://graph.microsoft.com/v1.0/chats",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.token}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"chatType\":\"oneOnOne\",\"members\":[{\"@odata.type\":\"#microsoft.graph.aadUserConversationMember\",\"roles\":[\"owner\"],\"user@odata.bind\":\"https://graph.microsoft.com/v1.0/users('{{trigger.to}}')\"}]}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://graph.microsoft.com/v1.0/chats/{{steps[3].id}}/messages",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.token}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"body\":{\"contentType\":\"html\",\"content\":\"{{trigger.message}}<br><br><em>Sent via Claude EA</em>\"}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://graph.microsoft.com/v1.0/teams/{{trigger.team_id}}/channels/{{trigger.to}}/messages",
        "method": "POST",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.token}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"body\":{\"contentType\":\"html\",\"content\":\"{{trigger.message}}<br><br><em>Sent via Claude EA</em>\"}}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "REPLACE_WITH_DB_ID"
      },
      "mapper": {
        "properties": {
          "Title": {
            "title": [
              {
                "text": {
                  "content": "Teams message to {{trigger.to}}"
                }
              }
            ]
          },
          "Type": {
            "select": {
              "name": "Teams Chat"
            }
          },
          "Source": {
            "select": {
              "name": "Teams Chat"
            }
          },
          "Date": {
            "date": {
              "start": "{{formatDate(now; 'YYYY-MM-DD')}}"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{\"success\":true,\"message\":\"sent\"}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}