{
  "name": "EA-11 — Relationship CRUD",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {
        "ip": "",
        "method": "POST",
        "headers": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8162-a136-f6449ea9ddbc"
      },
      "mapper": {
        "properties": {
          "Name": {
            "title": [
              {
                "text": {
                  "content": "{{trigger.relationship.name}}"
                }
              }
            ]
          },
          "Type": {
            "select": {
              "name": "{{trigger.relationship.type}}"
            }
          },
          "Company": {
            "rich_text": [
              {
                "text": {
                  "content": "{{trigger.relationship.company}}"
                }
              }
            ]
          },
          "Email": {
            "email": "{{trigger.relationship.email}}"
          },
          "Stage": {
            "select": {
              "name": "{{trigger.relationship.stage}}"
            }
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "notion:updateAPage",
      "version": 2,
      "parameters": {},
      "mapper": {
        "page_id": "{{trigger.relationship_id}}",
        "properties": {}
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8162-a136-f6449ea9ddbc"
      },
      "mapper": {
        "filter": {
          "or": [
            {
              "property": "Name",
              "title": {
                "contains": "{{trigger.relationship.name}}"
              }
            },
            {
              "property": "Email",
              "email": {
                "equals": "{{trigger.relationship.email}}"
              }
            }
          ]
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8162-a136-f6449ea9ddbc"
      },
      "mapper": {
        "filter": {
          "and": [
            {
              "property": "Stage",
              "select": {
                "equals": "Active"
              }
            },
            {
              "property": "Last Interaction",
              "date": {
                "before": "{{formatDate(addDays(now; -7); 'YYYY-MM-DD')}}"
              }
            }
          ]
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{{JSON.stringify($result)}}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}