{
  "name": "EA-07 — Task Manager",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {
        "ip": "",
        "method": "POST",
        "headers": []
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "notion:createAPage",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8139-9ba0-fc0c24b0aa94"
      },
      "mapper": {
        "properties": {
          "Name": {
            "title": [
              {
                "text": {
                  "content": "{{trigger.task.name}}"
                }
              }
            ]
          },
          "Priority": {
            "select": {
              "name": "{{trigger.task.priority}}"
            }
          },
          "Project": {
            "select": {
              "name": "{{trigger.task.project}}"
            }
          },
          "Due Date": {
            "date": {
              "start": "{{trigger.task.due_date}}"
            }
          },
          "Notes": {
            "rich_text": [
              {
                "text": {
                  "content": "{{trigger.task.notes}}"
                }
              }
            ]
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "notion:updateAPage",
      "version": 2,
      "parameters": {},
      "mapper": {
        "page_id": "{{trigger.task_id}}",
        "properties": {
          "Name": {
            "title": [
              {
                "text": {
                  "content": "{{trigger.task.name}}"
                }
              }
            ]
          }
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "notion:updateAPage",
      "version": 2,
      "parameters": {},
      "mapper": {
        "page_id": "{{trigger.task_id}}",
        "properties": {
          "archived": true
        }
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8139-9ba0-fc0c24b0aa94"
      },
      "mapper": {
        "filter": {},
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    },
    {
      "id": 7,
      "module": "notion:searchObjects",
      "version": 2,
      "parameters": {
        "database_id": "31653dc5-eede-8139-9ba0-fc0c24b0aa94"
      },
      "mapper": {
        "filter": {
          "property": "Name",
          "title": {
            "contains": "{{trigger.query}}"
          }
        },
        "sorts": []
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        }
      }
    },
    {
      "id": 8,
      "module": "gateway:WebhookResponse",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": 200,
        "body": "{{JSON.stringify($result)}}",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    }
  }
}